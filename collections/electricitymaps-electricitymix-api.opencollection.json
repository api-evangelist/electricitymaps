{
  "opencollection": "1.0.0",
  "info": {
    "name": "Electricity Maps CarbonIntensity ElectricityMix API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "auth-token",
      "value": "{{auth-token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "ElectricityMix",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get electricity mix",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.electricitymap.org/v3/electricity-mix/:temporality",
            "params": [
              {
                "name": "temporality",
                "value": "",
                "type": "path",
                "description": "Time horizon of the signal."
              },
              {
                "name": "zone",
                "value": "",
                "type": "query",
                "description": "Zone identifier (e.g., SE, DE, US-CAL-CISO)."
              },
              {
                "name": "temporalGranularity",
                "value": "",
                "type": "query",
                "description": "Temporal aggregation of the response."
              }
            ]
          },
          "docs": "Power production and consumption breakdown by source."
        }
      ]
    }
  ],
  "bundled": true
}